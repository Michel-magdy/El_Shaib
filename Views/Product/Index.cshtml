@model El_Shaib.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "المنتجات";
}

<!-- ========== PRODUCT PAGE CSS ========== -->
<link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />

<!-- ========== BREADCRUMB / SUB-NAV ========== -->
<div class="products-subnav">
    <div class="container">
        <div class="subnav-links">
            <a asp-controller="Home" asp-action="Index" class="subnav-link">الرئيسية</a>
            <span class="subnav-link active">المنتجات</span>
        </div>
        <div class="subnav-badge">
            <i class="fas fa-store"></i>
            كل المنتجات المتاحة حالياً في مخازن الأقصر
        </div>
    </div>
</div>

<!-- ========== PRODUCTS HERO BANNER ========== -->
<section class="products-hero">
    <div class="container">
        <div class="products-hero-content">
            <div class="products-hero-badge">
                <i class="fas fa-egg"></i>
                منتجات بيض المائدة الطازجة
            </div>
            <h1>منتجات بيض المائدة الطازجة</h1>
            <p>
                بيض طازج من المزرعة إلى بيتك مباشرة في الأقصر. فحص يومي دقيق لضمان نظافة طبيعية. تغليف محكم
                لكل مناسبة وفاكهة بارزة بجودة ١٠٠٪
            </p>
            <div class="products-hero-badges">
                <span class="phero-badge">
                    <i class="fas fa-check-circle"></i>
                    طبيعي ١٠٠٪
                </span>
                <span class="phero-badge">
                    <i class="fas fa-clock"></i>
                    توصيل خلال 24 ساعة
                </span>
            </div>
        </div>
    </div>
</section>

<!-- ========== SEARCH & FILTER BAR ========== -->
<section class="products-filter-section">
    <div class="container">
        <form method="get" asp-controller="Product" asp-action="Index" id="catalogFilterForm">
            <input type="hidden" name="CategoryId" value="@Model.SelectedCategoryId" id="hiddenCategoryId" />
            <input type="hidden" name="Page" value="1" id="hiddenPage" />

            <!-- Search Row -->
            <div class="products-search-row">
                <div class="products-search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" name="Query" value="@Model.Query" placeholder="ابحث عن كرتونة بيض، بيض أحمر أو بلدي أو أبيض..." />
                </div>
                <div class="products-sort-dropdown">
                    <select name="SortBy" onchange="this.form.submit()">
                        <option value="popular" selected="@(Model.SelectedSort == "popular")">ترتيب حسب: الأكثر طلباً</option>
                        <option value="price_asc" selected="@(Model.SelectedSort == "price_asc")">الأقل سعراً</option>
                        <option value="price_desc" selected="@(Model.SelectedSort == "price_desc")">الأعلى سعراً</option>
                        <option value="newest" selected="@(Model.SelectedSort == "newest")">الأحدث</option>
                    </select>
                    <i class="fas fa-chevron-down"></i>
                </div>
            </div>

            <!-- Category Filter Tags -->
            <div class="products-filter-tags">
                <span class="filter-tag-label">
                    <i class="fas fa-filter"></i>
                    التصنيف:
                </span>
                <a asp-controller="Product" asp-action="Index"
                   asp-route-Query="@Model.Query"
                   asp-route-SortBy="@Model.SelectedSort"
                   class="filter-tag @(!Model.SelectedCategoryId.HasValue ? "active" : "")">
                    كل المنتجات
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-controller="Product" asp-action="Index"
                       asp-route-CategoryId="@cat.Id"
                       asp-route-Query="@Model.Query"
                       asp-route-SortBy="@Model.SelectedSort"
                       class="filter-tag @(Model.SelectedCategoryId == cat.Id ? "active" : "")">
                        @cat.Name
                    </a>
                }
            </div>

            <!-- Active Filters / Results Info -->
            <div class="products-results-info">
                <span class="results-count">
                    <i class="fas fa-th-large"></i>
                    @Model.TotalCount منتج متوفر
                </span>
                <span class="results-filter-active">
                    <i class="fas fa-check-circle"></i>
                    @(Model.CurrentCategory?.Name ?? "كل المنتجات")
                </span>
            </div>
        </form>
    </div>
</section>

<!-- ========== PRODUCTS GRID ========== -->
<section class="products-grid-section">
    <div class="container">
        @if (Model.Products == null || Model.Products.Count == 0)
        {
            <div class="products-empty">
                <div class="empty-icon">
                    <i class="fas fa-egg"></i>
                </div>
                <h3>لا توجد منتجات مطابقة للبحث</h3>
                <p>لم نجد أي منتجات تطابق معايير البحث الحالية. جرب تغيير كلمة البحث أو تصفح كل المنتجات.</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom mt-3">
                    <i class="fas fa-undo me-2"></i>
                    عرض كل المنتجات
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    var primaryImage = product.Images?.FirstOrDefault(img => img.IsPrimary)
                        ?? product.Images?.FirstOrDefault();
                    var hasDiscount = product.OldPrice.HasValue && product.OldPrice > product.Price;
                    var discountPercent = hasDiscount
                        ? (int)Math.Round((1 - (double)product.Price / (double)product.OldPrice!.Value) * 100)
                        : 0;

                    <div class="col-xl-3 col-lg-4 col-md-6">
                        <div class="pcard" data-product-id="@product.Id">
                            <!-- Product Image -->
                            <div class="pcard-image">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                    <img src="@(primaryImage?.ImageUrl ?? "/images/HeroImage.jpg")"
                                         alt="@(primaryImage?.AltText ?? product.Name)" loading="lazy" />
                                </a>

                                <!-- Badges -->
                                <div class="pcard-badges">
                                    @if (product.Category != null)
                                    {
                                        <span class="pcard-badge pcard-badge--category">@product.Category.Name</span>
                                    }
                                    @if (hasDiscount)
                                    {
                                        <span class="pcard-badge pcard-badge--discount">خصم @discountPercent%</span>
                                    }
                                    @if (product.IsFeatured)
                                    {
                                        <span class="pcard-badge pcard-badge--featured">طازج</span>
                                    }
                                </div>

                                <!-- Wishlist -->
                                <button class="pcard-wishlist btn-wishlist-toggle" type="button" data-product-id="@product.Id" aria-label="إضافة إلى المفضلة">
                                    <i class="far fa-heart"></i>
                                </button>
                            </div>

                            <!-- Product Body -->
                            <div class="pcard-body">
                                @if (!string.IsNullOrEmpty(product.PackageType) || !string.IsNullOrEmpty(product.UnitSize))
                                {
                                    <span class="pcard-category">
                                        @(product.PackageType ?? product.UnitSize)
                                    </span>
                                }

                                <h3 class="pcard-title">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                        @product.Name
                                    </a>
                                </h3>

                                <div class="pcard-price-row">
                                    <div class="pcard-price">
                                        <span class="price-val">@product.Price.ToString("0.00")</span>
                                        <span class="price-curr">ج.م</span>
                                    </div>
                                    @if (hasDiscount)
                                    {
                                        <span class="pcard-old-price">@product.OldPrice!.Value.ToString("0.00") ج.م</span>
                                    }
                                </div>

                                <!-- Actions -->
                                <div class="pcard-actions">
                                    <div class="pcard-qty">
                                        <button class="qty-btn qty-minus" type="button" aria-label="تقليل الكمية">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <input type="number" class="qty-input" value="1" min="1" max="@(product.StockQuantity > 0 ? product.StockQuantity : 99)" />
                                        <button class="qty-btn qty-plus" type="button" aria-label="زيادة الكمية">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>

                                    <button class="pcard-basket btn-add-cart-ajax" type="button" data-product-id="@product.Id" title="أضف للسلة">
                                        <span class="pcard-basket-label">
                                            <i class="fas fa-cart-plus"></i>
                                            أضف للسلة
                                        </span>
                                    </button>
                                </div>

                                <div class="d-flex gap-2 mt-2">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary btn-sm flex-fill" type="button">
                                        تفاصيل أكثر
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="products-pagination">
                    <nav aria-label="التنقل بين الصفحات">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-Page="@(Model.CurrentPage - 1)"
                                   asp-route-CategoryId="@Model.SelectedCategoryId"
                                   asp-route-Query="@Model.Query"
                                   asp-route-SortBy="@Model.SelectedSort"
                                   aria-label="السابق">
                                    <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-controller="Product"
                                       asp-action="Index"
                                       asp-route-Page="@p"
                                       asp-route-CategoryId="@Model.SelectedCategoryId"
                                       asp-route-Query="@Model.Query"
                                       asp-route-SortBy="@Model.SelectedSort">
                                        @p
                                    </a>
                                </li>
                            }
                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-controller="Product"
                                   asp-action="Index"
                                   asp-route-Page="@(Model.CurrentPage + 1)"
                                   asp-route-CategoryId="@Model.SelectedCategoryId"
                                   asp-route-Query="@Model.Query"
                                   asp-route-SortBy="@Model.SelectedSort"
                                   aria-label="التالي">
                                    <i class="fas fa-chevron-left"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</section>

<!-- ========== WHY CHOOSE US / GUARANTEE BANNER ========== -->
<section class="products-guarantee">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 order-lg-2">
                <div class="guarantee-content">
                    <div class="guarantee-badge">
                        <i class="fas fa-shield-alt"></i>
                        إنتاج محلي طازج | الشايب - الأقصر
                    </div>
                    <h2>
                        نقاء، أمان، وجودة
                        <br />مضمونة حتى باب
                        <br />بيتك
                    </h2>
                    <p>
                        جميع منتجاتنا طبيعية ١٠٠٪ يتم جمعها وفحصها يومياً في مزارعنا
                        الخاصة لضمان تقديم أعلى درجات الجودة والنظافة الغذائية.
                    </p>
                </div>
            </div>
            <div class="col-lg-6 order-lg-1">
                <div class="guarantee-cards">
                    <div class="guarantee-card">
                        <div class="guarantee-icon">
                            <i class="fas fa-sync-alt"></i>
                        </div>
                        <div>
                            <h5>استبدال فوري</h5>
                            <p>في حالة وجود أي عيب بالمنتج نقوم بالاستبدال الفوري</p>
                        </div>
                    </div>
                    <div class="guarantee-card">
                        <div class="guarantee-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div>
                            <h5>دفع مريح</h5>
                            <p>الدفع عند الاستلام أو التحويل البنكي بطرق مريحة ومتعددة</p>
                        </div>
                    </div>
                    <div class="guarantee-card">
                        <div class="guarantee-icon">
                            <i class="fas fa-truck"></i>
                        </div>
                        <div>
                            <h5>توصيل 24 ساعة</h5>
                            <p>توصيل سريع لجميع مناطق الأقصر خلال يوم عمل واحد</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Quantity +/- controls
        document.querySelectorAll('.qty-plus').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = this.closest('.pcard-qty').querySelector('.qty-input');
                const max = parseInt(input.getAttribute('max')) || 99;
                let val = parseInt(input.value) || 1;
                if (val < max) input.value = val + 1;
            });
        });

        document.querySelectorAll('.qty-minus').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = this.closest('.pcard-qty').querySelector('.qty-input');
                let val = parseInt(input.value) || 1;
                if (val > 1) input.value = val - 1;
            });
        });

        // AJAX Add to Cart
        document.querySelectorAll('.btn-add-cart-ajax').forEach(btn => {
            btn.addEventListener('click', async function () {
                const pcard = this.closest('.pcard');
                const productId = this.dataset.productId;
                const qtyInput = pcard.querySelector('.qty-input');
                const quantity = qtyInput ? parseInt(qtyInput.value) || 1 : 1;

                this.disabled = true;
                const originalHtml = this.innerHTML;
                this.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الإضافة...';

                try {
                    const formData = new FormData();
                    formData.append('productId', productId);
                    formData.append('quantity', quantity);

                    const res = await fetch('/Cart/Add', {
                        method: 'POST',
                        body: formData
                    });
                    const data = await res.json();
                    if (data.success) {
                        document.querySelectorAll('.cart-badge').forEach(b => b.textContent = data.totalCount);
                        if (window.showToast) {
                            window.showToast(data.message, 'success');
                        } else {
                            alert(data.message);
                        }
                    } else {
                        if (window.showToast) {
                            window.showToast(data.message, 'error');
                        } else {
                            alert(data.message);
                        }
                    }
                } catch (err) {
                    console.error('Add to cart failed:', err);
                } finally {
                    this.disabled = false;
                    this.innerHTML = originalHtml;
                }
            });
        });
    </script>
}
