@model El_Shaib.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "المنتجات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/products.css" asp-append-version="true" />
}

<!-- ========== BREADCRUMB / SUB-NAV ========== -->
<div class="products-subnav">
    <div class="container">
        <div class="subnav-links">
            <a asp-controller="Home" asp-action="Index" class="subnav-link">الرئيسية</a>
            <span class="subnav-link active">المنتجات</span>
        </div>
        <div class="subnav-badge">
            <i class="fas fa-store"></i>
            كل المنتجات المتاحة حالياً في مخازن الأقصر
        </div>
    </div>
</div>

<!-- ========== PRODUCTS HERO BANNER ========== -->
<section class="products-hero">
    <div class="container">
        <div class="products-hero-content">
            <div class="products-hero-badge">
                <i class="fas fa-egg"></i>
                منتجات بيض المائدة الطازجة
            </div>
            <h1>منتجات بيض المائدة الطازجة</h1>
            <p>
                بيض طازج من المزرعة إلى بيتك مباشرة في الأقصر. فحص يومي دقيق لضمان نظافة طبيعية. تغليف محكم
                لكل مناسبة وفاكهة بارزة بجودة ١٠٠٪
            </p>
            <div class="products-hero-badges">
                <span class="phero-badge">
                    <i class="fas fa-check-circle"></i>
                    طبيعي ١٠٠٪
                </span>
                <span class="phero-badge">
                    <i class="fas fa-clock"></i>
                    توصيل خلال 24 ساعة
                </span>
            </div>
        </div>
    </div>
</section>

<!-- ========== SEARCH & FILTER BAR ========== -->
<section class="products-filter-section">
    <div class="container">
        <form method="get" asp-controller="Product" asp-action="Index" id="catalogFilterForm" onsubmit="return false;">
            <input type="hidden" name="CategoryId" value="@Model.SelectedCategoryId" id="hiddenCategoryId" />
            <input type="hidden" name="Page" value="@Model.CurrentPage" id="hiddenPage" />

            <!-- Search Row -->
            <div class="products-search-row">
                <div class="products-search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" name="Query" id="catalogSearchInput" value="@Model.Query" placeholder="ابحث بالاسم، الحجم، نوع التغليف..." autocomplete="off" />
                    @if (!string.IsNullOrWhiteSpace(Model.Query))
                    {
                        <button type="button" class="btn btn-sm btn-link text-muted position-absolute end-0 top-50 translate-middle-y me-3" id="clearSearchBtn" title="مسح البحث">
                            <i class="fas fa-times-circle"></i>
                        </button>
                    }
                </div>
                <div class="products-sort-dropdown">
                    <select name="SortBy" id="catalogSortSelect">
                        <option value="popular" selected="@(Model.SelectedSort == "popular")">ترتيب حسب: الأكثر طلباً</option>
                        <option value="price_asc" selected="@(Model.SelectedSort == "price_asc")">الأقل سعراً</option>
                        <option value="price_desc" selected="@(Model.SelectedSort == "price_desc")">الأعلى سعراً</option>
                        <option value="newest" selected="@(Model.SelectedSort == "newest")">الأحدث</option>
                    </select>
                    <i class="fas fa-chevron-down"></i>
                </div>
            </div>

            <!-- Category Filter Tags -->
            <div class="products-filter-tags">
                <span class="filter-tag-label">
                    <i class="fas fa-filter"></i>
                    التصنيف:
                </span>
                <a href="#"
                   data-category-id=""
                   class="filter-tag ajax-category-tag @(!Model.SelectedCategoryId.HasValue ? "active" : "")">
                    كل المنتجات
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a href="#"
                       data-category-id="@cat.Id"
                       class="filter-tag ajax-category-tag @(Model.SelectedCategoryId == cat.Id ? "active" : "")">
                        @cat.Name
                    </a>
                }
            </div>
        </form>
    </div>
</section>

<!-- ========== PRODUCTS GRID (AJAX CONTAINER) ========== -->
<section class="products-grid-section position-relative" id="productsSection">
    <div class="container position-relative" style="min-height: 350px;">
        <!-- Loading Overlay -->
        <div id="productsLoadingOverlay" class="position-absolute top-0 start-0 w-100 h-100 d-none"
             style="background: rgba(255, 255, 255, 0.75); backdrop-filter: blur(2px); z-index: 20; border-radius: 16px;">
            <div class="d-flex flex-column align-items-center justify-content-center h-100" style="min-height: 250px;">
                <div class="spinner-border text-success" role="status" style="width: 3rem; height: 3rem;">
                    <span class="visually-hidden">جاري التحميل...</span>
                </div>
                <span class="mt-2 fw-semibold text-success">جاري تحديث المنتجات...</span>
            </div>
        </div>

        <!-- Partial View Target -->
        <div id="productsGridContainer">
            <partial name="_ProductGridPartial" model="Model" />
        </div>
    </div>
</section>

<!-- ========== WHY CHOOSE US / GUARANTEE BANNER ========== -->
<section class="products-guarantee">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 order-lg-2">
                <div class="guarantee-content">
                    <div class="guarantee-badge">
                        <i class="fas fa-shield-alt"></i>
                        إنتاج محلي طازج | الشايب - الأقصر
                    </div>
                    <h2>
                        نقاء، أمان، وجودة
                        <br />مضمونة حتى باب
                        <br />بيتك
                    </h2>
                    <p>
                        جميع منتجاتنا طبيعية ١٠٠٪ يتم جمعها وفحصها يومياً في مزارعنا
                        الخاصة لضمان تقديم أعلى درجات الجودة والنظافة الغذائية.
                    </p>
                </div>
            </div>
            <div class="col-lg-6 order-lg-1">
                <div class="guarantee-cards">
                    <div class="guarantee-card">
                        <div class="guarantee-icon">
                            <i class="fas fa-sync-alt"></i>
                        </div>
                        <div>
                            <h5>استبدال فوري</h5>
                            <p>في حالة وجود أي عيب بالمنتج نقوم بالاستبدال الفوري</p>
                        </div>
                    </div>
                    <div class="guarantee-card">
                        <div class="guarantee-icon">
                            <i class="fas fa-wallet"></i>
                        </div>
                        <div>
                            <h5>دفع مريح</h5>
                            <p>الدفع عند الاستلام أو التحويل البنكي بطرق مريحة ومتعددة</p>
                        </div>
                    </div>
                    <div class="guarantee-card">
                        <div class="guarantee-icon">
                            <i class="fas fa-truck"></i>
                        </div>
                        <div>
                            <h5>توصيل 24 ساعة</h5>
                            <p>توصيل سريع لجميع مناطق الأقصر خلال يوم عمل واحد</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('catalogFilterForm');
            const searchInput = document.getElementById('catalogSearchInput');
            const sortSelect = document.getElementById('catalogSortSelect');
            const hiddenCategoryId = document.getElementById('hiddenCategoryId');
            const hiddenPage = document.getElementById('hiddenPage');
            const gridContainer = document.getElementById('productsGridContainer');
            const loadingOverlay = document.getElementById('productsLoadingOverlay');
            const categoryTags = document.querySelectorAll('.ajax-category-tag');

            let searchTimeout = null;
            let activeAbortController = null;

            // Fetch products via AJAX partial view
            async function fetchProducts(page = 1, updateHistory = true) {
                hiddenPage.value = page;

                const params = new URLSearchParams();
                const queryVal = searchInput.value.trim();
                const categoryVal = hiddenCategoryId.value.trim();
                const sortVal = sortSelect.value.trim();

                if (queryVal) params.append('Query', queryVal);
                if (categoryVal) params.append('CategoryId', categoryVal);
                if (sortVal && sortVal !== 'popular') params.append('SortBy', sortVal);
                if (page > 1) params.append('Page', page);

                const queryString = params.toString();
                const filterUrl = '/Product/Filter?' + queryString;
                const browserUrl = '/Product' + (queryString ? '?' + queryString : '');

                if (activeAbortController) {
                    activeAbortController.abort();
                }
                activeAbortController = new AbortController();

                loadingOverlay.classList.remove('d-none');

                try {
                    const response = await fetch(filterUrl, {
                        method: 'GET',
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        signal: activeAbortController.signal
                    });

                    if (response.ok) {
                        const html = await response.text();

                        // Pre-cache images before inserting HTML to prevent blank flash
                        const tempDiv = document.createElement('div');
                        tempDiv.innerHTML = html;
                        const imgElements = tempDiv.querySelectorAll('img');
                        const imagePromises = Array.from(imgElements).map(img => {
                            return new Promise(resolve => {
                                if (!img.src || img.src === window.location.href) {
                                    resolve();
                                    return;
                                }
                                const preload = new Image();
                                preload.onload = resolve;
                                preload.onerror = resolve; // Don't block on failed images
                                preload.src = img.src;
                                // Resolve after 3s max to avoid blocking forever
                                setTimeout(resolve, 3000);
                            });
                        });

                        // Wait for images to pre-cache (with 3s timeout per image)
                        await Promise.all(imagePromises);

                        // Smooth swap: fade out, replace, fade in
                        gridContainer.style.opacity = '0';
                        gridContainer.style.transition = 'opacity 0.15s ease';
                        await new Promise(r => setTimeout(r, 150));

                        gridContainer.innerHTML = html;
                        gridContainer.style.opacity = '1';

                        if (updateHistory) {
                            window.history.pushState({
                                query: queryVal,
                                categoryId: categoryVal,
                                sortBy: sortVal,
                                page: page
                            }, '', browserUrl);
                        }
                    }
                } catch (err) {
                    if (err.name !== 'AbortError') {
                        console.error('Failed to filter products:', err);
                    }
                } finally {
                    loadingOverlay.classList.add('d-none');
                }
            }

            // 1. Live search with 300ms debounce
            searchInput.addEventListener('input', function () {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(() => {
                    fetchProducts(1);
                }, 300);
            });

            // Clear search button if present
            const clearSearchBtn = document.getElementById('clearSearchBtn');
            if (clearSearchBtn) {
                clearSearchBtn.addEventListener('click', function () {
                    searchInput.value = '';
                    this.remove();
                    fetchProducts(1);
                });
            }

            // 2. Sort dropdown change
            sortSelect.addEventListener('change', function () {
                fetchProducts(1);
            });

            // 3. Category tags click
            categoryTags.forEach(tag => {
                tag.addEventListener('click', function (e) {
                    e.preventDefault();

                    categoryTags.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');

                    const catId = this.getAttribute('data-category-id') || '';
                    hiddenCategoryId.value = catId;

                    fetchProducts(1);
                });
            });

            // 4. Delegated pagination click
            gridContainer.addEventListener('click', function (e) {
                const pageLink = e.target.closest('.ajax-page-link');
                if (pageLink) {
                    e.preventDefault();
                    const targetPage = parseInt(pageLink.getAttribute('data-page'));
                    if (targetPage && !pageLink.parentElement.classList.contains('disabled') && !pageLink.parentElement.classList.contains('active')) {
                        fetchProducts(targetPage);

                        // Smoothly scroll up to products grid
                        const section = document.getElementById('productsSection');
                        if (section) {
                            section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    }
                    return;
                }

                // 5. Delegated Reset Filters button click
                const resetBtn = e.target.closest('.btn-reset-filters');
                if (resetBtn) {
                    e.preventDefault();
                    searchInput.value = '';
                    hiddenCategoryId.value = '';
                    sortSelect.value = 'popular';

                    categoryTags.forEach(t => t.classList.remove('active'));
                    const allTag = document.querySelector('.ajax-category-tag[data-category-id=""]');
                    if (allTag) allTag.classList.add('active');

                    fetchProducts(1);
                    return;
                }

                // 6. Delegated Quantity +/-
                const plusBtn = e.target.closest('.qty-plus');
                if (plusBtn) {
                    const qtyWrapper = plusBtn.closest('.pcard-qty');
                    const input = qtyWrapper ? qtyWrapper.querySelector('.qty-input') : null;
                    if (input) {
                        const max = parseInt(input.getAttribute('max')) || 99;
                        let val = parseInt(input.value) || 1;
                        if (val < max) input.value = val + 1;
                    }
                    return;
                }

                const minusBtn = e.target.closest('.qty-minus');
                if (minusBtn) {
                    const qtyWrapper = minusBtn.closest('.pcard-qty');
                    const input = qtyWrapper ? qtyWrapper.querySelector('.qty-input') : null;
                    if (input) {
                        let val = parseInt(input.value) || 1;
                        if (val > 1) input.value = val - 1;
                    }
                    return;
                }

                // 7. Delegated AJAX Add to Cart (Optimistic UI & Low INP)
                const cartBtn = e.target.closest('.btn-add-cart-ajax');
                if (cartBtn) {
                    const pcard = cartBtn.closest('.pcard');
                    const productId = cartBtn.dataset.productId;
                    const qtyInput = pcard ? pcard.querySelector('.qty-input') : null;
                    const quantity = qtyInput ? parseInt(qtyInput.value) || 1 : 1;

                    // 0. Trigger Flying minimized product animation
                    if (window.flyToCart) {
                        window.flyToCart(cartBtn);
                    }

                    // 1. Optimistic badge update (<16ms paint)
                    const badges = document.querySelectorAll('.cart-badge');
                    let prevCount = 0;
                    badges.forEach(b => {
                        prevCount = parseInt(b.textContent) || 0;
                        b.textContent = prevCount + quantity;
                        b.classList.remove('badge-pop');
                        void b.offsetWidth; // trigger reflow for animation restart
                        b.classList.add('badge-pop');
                    });
                    setTimeout(() => badges.forEach(b => b.classList.remove('badge-pop')), 400);

                    // 2. Non-blocking button visual confirmation (never set disabled=true to avoid event stalls)
                    const originalHtml = cartBtn.innerHTML;
                    cartBtn.classList.add('btn-add-success');
                    cartBtn.innerHTML = '<span class="pcard-basket-label" style="color:#fff;"><i class="fas fa-check"></i> تمت الإضافة</span>';
                    setTimeout(() => {
                        cartBtn.classList.remove('btn-add-success');
                        cartBtn.innerHTML = originalHtml;
                    }, 1200);

                    // 3. Background asynchronous sync
                    const formData = new FormData();
                    formData.append('productId', productId);
                    formData.append('quantity', quantity);

                    fetch('/Cart/Add', {
                        method: 'POST',
                        body: formData
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            badges.forEach(b => b.textContent = data.totalCount);
                            if (window.showToast) {
                                window.showToast(data.message, 'success');
                            }
                        } else {
                            // Rollback optimistic count
                            badges.forEach(b => b.textContent = prevCount);
                            if (window.showToast) {
                                window.showToast(data.message, 'error');
                            }
                        }
                    })
                    .catch(err => {
                        console.error('Add to cart failed:', err);
                        badges.forEach(b => b.textContent = prevCount);
                    });
                }
            });

            // 8. Handle browser Back/Forward navigation
            window.addEventListener('popstate', function (e) {
                if (e.state) {
                    searchInput.value = e.state.query || '';
                    hiddenCategoryId.value = e.state.categoryId || '';
                    sortSelect.value = e.state.sortBy || 'popular';

                    categoryTags.forEach(t => {
                        const cid = t.getAttribute('data-category-id') || '';
                        t.classList.toggle('active', cid === (e.state.categoryId || ''));
                    });

                    fetchProducts(e.state.page || 1, false);
                } else {
                    location.reload();
                }
            });
        });
    </script>
}
