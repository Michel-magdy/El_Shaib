@model El_Shaib.ViewModels.ProductListViewModel

@{
    var startItem = Model.TotalCount > 0 ? (Model.CurrentPage - 1) * Model.PageSize + 1 : 0;
    var endItem = Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount);
}

<!-- Active Filters / Results Info -->
<div class="products-results-info mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <span class="results-count">
        <i class="fas fa-th-large text-success me-1"></i>
        @if (Model.TotalCount > 0)
        {
            <span>عرض <strong>@startItem - @endItem</strong> من إجمالي <strong>@Model.TotalCount</strong> منتج</span>
            @if (Model.TotalPages > 1)
            {
                <span class="text-muted ms-1">(صفحة @Model.CurrentPage من @Model.TotalPages)</span>
            }
            else
            {
                <span class="text-muted ms-1">(صفحة 1 من 1)</span>
            }
        }
        else
        {
            <span><strong>0</strong> منتج متوفر</span>
        }
    </span>
    <span class="results-filter-active badge bg-light text-dark border px-3 py-2 rounded-pill">
        <i class="fas fa-check-circle text-success me-1"></i>
        @(Model.CurrentCategory?.Name ?? "كل المنتجات")
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <span> | بحث: "@Model.Query"</span>
        }
    </span>
</div>

@if (Model.Products == null || Model.Products.Count == 0)
{
    <div class="products-empty">
        <div class="empty-icon">
            <i class="fas fa-egg"></i>
        </div>
        <h3>لا توجد منتجات مطابقة للبحث</h3>
        <p>لم نجد أي منتجات تطابق معايير البحث الحالية. جرب تغيير كلمة البحث أو تصفح كل المنتجات.</p>
        <button type="button" class="btn btn-primary-custom mt-3 btn-reset-filters">
            <i class="fas fa-undo me-2"></i>
            عرض كل المنتجات
        </button>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var product in Model.Products)
        {
            var primaryImage = product.Images?.FirstOrDefault(img => img.IsPrimary)
                ?? product.Images?.FirstOrDefault();
            var hasDiscount = product.OldPrice.HasValue && product.OldPrice > product.Price;
            var discountPercent = hasDiscount
                ? (int)Math.Round((1 - (double)product.Price / (double)product.OldPrice!.Value) * 100)
                : 0;

            <div class="col-xl-3 col-lg-4 col-md-6">
                <div class="pcard" data-product-id="@product.Id">
                    <!-- Product Image -->
                    <div class="pcard-image">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="pcard-image-link">
                            <img src="@(primaryImage?.ImageUrl ?? "/images/HeroImage.jpg")"
                                 alt="@(primaryImage?.AltText ?? product.Name)"
                                 width="280"
                                 height="200"
                                 fetchpriority="high"
                                 onerror="this.onerror=null;this.src='/images/HeroImage.jpg';"
                                 style="object-fit: cover;" />
                        </a>

                        <!-- Badges -->
                        <div class="pcard-badges">
                            @if (product.Category != null)
                            {
                                <span class="pcard-badge pcard-badge--category">@product.Category.Name</span>
                            }
                            @if (hasDiscount)
                            {
                                <span class="pcard-badge pcard-badge--discount">خصم @discountPercent%</span>
                            }
                            @if (product.IsFeatured)
                            {
                                <span class="pcard-badge pcard-badge--featured">طازج</span>
                            }
                        </div>

                        <!-- Wishlist -->
                        <button class="pcard-wishlist btn-wishlist-toggle" type="button" data-product-id="@product.Id" aria-label="إضافة إلى المفضلة">
                            <i class="far fa-heart"></i>
                        </button>
                    </div>

                    <!-- Product Body -->
                    <div class="pcard-body">
                        @if (!string.IsNullOrEmpty(product.PackageType) || !string.IsNullOrEmpty(product.UnitSize))
                        {
                            <span class="pcard-category">
                                @(product.PackageType ?? product.UnitSize)
                            </span>
                        }

                        <h3 class="pcard-title">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                @product.Name
                            </a>
                        </h3>

                        <div class="pcard-price-row">
                            <div class="pcard-price">
                                <span class="price-val">@product.Price.ToString("0.00")</span>
                                <span class="price-curr">ج.م</span>
                            </div>
                            @if (hasDiscount)
                            {
                                <span class="pcard-old-price">@product.OldPrice!.Value.ToString("0.00") ج.م</span>
                            }
                        </div>

                        <!-- Card Action Buttons -->
                        <div class="pcard-actions">
                            <div class="pcard-qty" title="تحديد الكمية">
                                <button class="qty-btn qty-minus" type="button" aria-label="تقليل الكمية">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <input type="number" class="qty-input" value="1" min="1" max="@(product.StockQuantity > 0 ? product.StockQuantity : 99)" aria-label="الكمية" />
                                <button class="qty-btn qty-plus" type="button" aria-label="زيادة الكمية">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>

                            <button class="pcard-btn-add btn-add-cart-ajax" type="button" data-product-id="@product.Id" title="أضف إلى سلة التسوق">
                                <i class="fas fa-cart-plus"></i>
                                <span class="pcard-basket-label">أضف للسلة</span>
                            </button>
                        </div>

                        <div class="pcard-secondary-actions">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" class="pcard-details-btn">
                                <span>عرض التفاصيل</span>
                                <i class="fas fa-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="products-pagination mt-4">
            <nav aria-label="التنقل بين الصفحات">
                <ul class="pagination justify-content-center flex-wrap gap-1">
                    <!-- Previous Page -->
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link ajax-page-link"
                           href="@(Model.CurrentPage > 1 ? Url.Action("Index", "Product", new { Page = Model.CurrentPage - 1, CategoryId = Model.SelectedCategoryId, Query = Model.Query, SortBy = Model.SelectedSort, PageSize = Model.PageSize }) : "#")"
                           data-page="@(Model.CurrentPage - 1)"
                           data-category-id="@(Model.SelectedCategoryId?.ToString() ?? "")"
                           aria-label="السابق"
                           title="الصفحة السابقة">
                            <i class="fas fa-chevron-right me-1"></i>
                            <span class="d-none d-sm-inline">السابق</span>
                        </a>
                    </li>

                    @{
                        int totalPages = Model.TotalPages;
                        int currentPage = Model.CurrentPage;
                        int windowSize = 2; // Show 2 pages before and after current
                        int startPage = Math.Max(1, currentPage - windowSize);
                        int endPage = Math.Min(totalPages, currentPage + windowSize);

                        if (currentPage <= windowSize + 1)
                        {
                            endPage = Math.Min(totalPages, 1 + (windowSize * 2));
                        }
                        if (currentPage >= totalPages - windowSize)
                        {
                            startPage = Math.Max(1, totalPages - (windowSize * 2));
                        }
                    }

                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link ajax-page-link"
                               href="@Url.Action("Index", "Product", new { Page = 1, CategoryId = Model.SelectedCategoryId, Query = Model.Query, SortBy = Model.SelectedSort, PageSize = Model.PageSize })"
                               data-page="1"
                               data-category-id="@(Model.SelectedCategoryId?.ToString() ?? "")">
                                1
                            </a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled" aria-hidden="true">
                                <span class="page-link border-0 bg-transparent text-muted">…</span>
                            </li>
                        }
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link ajax-page-link"
                               href="@Url.Action("Index", "Product", new { Page = p, CategoryId = Model.SelectedCategoryId, Query = Model.Query, SortBy = Model.SelectedSort, PageSize = Model.PageSize })"
                               data-page="@p"
                               data-category-id="@(Model.SelectedCategoryId?.ToString() ?? "")"
                               aria-current="@(p == currentPage ? "page" : null)">
                                @p
                            </a>
                        </li>
                    }

                    @if (endPage < totalPages)
                    {
                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled" aria-hidden="true">
                                <span class="page-link border-0 bg-transparent text-muted">…</span>
                            </li>
                        }
                        <li class="page-item">
                            <a class="page-link ajax-page-link"
                               href="@Url.Action("Index", "Product", new { Page = totalPages, CategoryId = Model.SelectedCategoryId, Query = Model.Query, SortBy = Model.SelectedSort, PageSize = Model.PageSize })"
                               data-page="@totalPages"
                               data-category-id="@(Model.SelectedCategoryId?.ToString() ?? "")">
                                @totalPages
                            </a>
                        </li>
                    }

                    <!-- Next Page -->
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link ajax-page-link"
                           href="@(Model.CurrentPage < Model.TotalPages ? Url.Action("Index", "Product", new { Page = Model.CurrentPage + 1, CategoryId = Model.SelectedCategoryId, Query = Model.Query, SortBy = Model.SelectedSort, PageSize = Model.PageSize }) : "#")"
                           data-page="@(Model.CurrentPage + 1)"
                           data-category-id="@(Model.SelectedCategoryId?.ToString() ?? "")"
                           aria-label="التالي"
                           title="الصفحة التالية">
                            <span class="d-none d-sm-inline">التالي</span>
                            <i class="fas fa-chevron-left ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
    else if (Model.TotalCount > 0)
    {
        <div class="products-pagination mt-4">
            <nav aria-label="التنقل بين الصفحات">
                <ul class="pagination justify-content-center flex-wrap gap-1">
                    <li class="page-item disabled">
                        <span class="page-link" aria-hidden="true">
                            <i class="fas fa-chevron-right me-1"></i>
                            <span class="d-none d-sm-inline">السابق</span>
                        </span>
                    </li>
                    <li class="page-item active" aria-current="page">
                        <span class="page-link">1</span>
                    </li>
                    <li class="page-item disabled">
                        <span class="page-link" aria-hidden="true">
                            <span class="d-none d-sm-inline">التالي</span>
                            <i class="fas fa-chevron-left ms-1"></i>
                        </span>
                    </li>
                </ul>
            </nav>
        </div>
    }
}

