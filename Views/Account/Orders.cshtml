@model List<El_Shaib.Models.Order>
@{
    ViewData["Title"] = "طلباتي السابقة";
}

<div class="cart-breadcrumb">
    <div class="container">
        <nav aria-label="مسار التنقل">
            <ol class="breadcrumb-list">
                <li><a asp-controller="Home" asp-action="Index"><i class="fas fa-home"></i> الرئيسية</a></li>
                <li class="active"><i class="fas fa-chevron-left breadcrumb-sep"></i> <span>طلباتي</span></li>
            </ol>
        </nav>
    </div>
</div>

<section class="py-5" style="background-color: #f8f9fa;">
    <div class="container" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h1 class="h3 fw-bold mb-1" style="color: var(--primary-dark, #0d2818);">
                    <i class="fas fa-box-archive text-success me-2"></i>
                    سجل طلباتك
                </h1>
                <p class="text-muted mb-0">تابع جميع طلباتك السابقة وحالتها</p>
            </div>
            <a asp-controller="Product" asp-action="Index" class="btn btn-outline-success">
                <i class="fas fa-store me-1"></i> طلب جديد
            </a>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4">
                <div class="mx-auto mb-3" style="width: 70px; height: 70px; background-color: #e8f5e9; color: var(--primary, #1b4332); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                    <i class="fas fa-shopping-bag"></i>
                </div>
                <h3 class="h5 fw-bold mb-2">لا توجد طلبات سابقة حتى الآن</h3>
                <p class="text-muted mb-4">لم تقم بإجراء أي طلبات حتى الآن. استمتع بتصفح منتجاتنا الطازجة واطلب الآن!</p>
                <div>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-success btn-lg px-4" style="background-color: var(--primary, #1b4332); border: none;">
                        تسوق المنتجات
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var order in Model)
                {
                    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3 border-bottom mb-3">
                            <div>
                                <strong class="fs-5" style="color: var(--primary, #1b4332);">@order.OrderNumber</strong>
                                <small class="text-muted d-block">بتاريخ: @order.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd - hh:mm tt")</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-warning text-dark px-3 py-2">
                                    @(order.Status switch
                                    {
                                        El_Shaib.Models.OrderStatus.Pending => "قيد المراجعة",
                                        El_Shaib.Models.OrderStatus.Confirmed => "تم التأكيد",
                                        El_Shaib.Models.OrderStatus.Processing => "قيد التجهيز",
                                        El_Shaib.Models.OrderStatus.OutForDelivery => "في الطريق للتوصيل",
                                        El_Shaib.Models.OrderStatus.Delivered => "تم التوصيل",
                                        El_Shaib.Models.OrderStatus.Cancelled => "ملغي",
                                        _ => "قيد المعالجة"
                                    })
                                </span>
                                <a asp-controller="Order" asp-action="Track" asp-route-orderNumber="@order.OrderNumber" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-search-location me-1"></i> تتبع
                                </a>
                            </div>
                        </div>

                        <div class="row g-2 align-items-center">
                            <div class="col-md-8">
                                <small class="text-muted d-block mb-1">المنتجات:</small>
                                <ul class="list-unstyled mb-0 small">
                                    @foreach (var item in order.Items)
                                    {
                                        <li>• @item.ProductName (الكمية: @item.Quantity)</li>
                                    }
                                </ul>
                            </div>
                            <div class="col-md-4 text-md-end">
                                <small class="text-muted d-block">الإجمالي النهائي:</small>
                                <strong class="fs-5 text-success">@order.Total.ToString("0.00") ج.م</strong>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

