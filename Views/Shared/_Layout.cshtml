@inject El_Shaib.Interfaces.ICartService CartService
<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - الشايب</title>

    <!-- DNS Prefetch & Preconnect for Fast External CDNs & Image Storage -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://puvhyyqwdpbcpalpxetu.supabase.co" crossorigin>
    <link rel="dns-prefetch" href="https://puvhyyqwdpbcpalpxetu.supabase.co">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">

    <!-- Google Fonts - Cairo (Essential weights with font-display: swap) -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome 6 (Preloaded for faster paint) -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" /></noscript>

    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/El_Shaib.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- ========== NAVBAR ========== -->
    <nav class="navbar navbar-expand-lg navbar-elshaib">
        <div class="container">
            <!-- Brand -->
            <div class="brand-shell">
                <a class="brand-link group" asp-controller="Home" asp-action="Index">
                    <picture>
                        <source srcset="/images/Logo.webp" type="image/webp">
                        <img alt="الشايب لإنتاج بيض المائدة" class="brand-logo" src="/images/Logo.jpg" width="48" height="48" decoding="async">
                    </picture>
                    <div class="brand-copy">
                        <span style="color: var(--primary-dark);">الشايب</span>
                        <span class="font-label-sm text-label-sm text-outline tracking-wider">لإنتاج بيض المائدة - الأقصر</span>
                    </div>
                </a>
            </div>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                    aria-controls="navbarMain" aria-expanded="false" aria-label="فتح القائمة">
                <span class="navbar-toggler-icon"></span>
            </button>

            @{
                var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
                var currentAct = ViewContext.RouteData.Values["Action"]?.ToString();
                var initialCartCount = await CartService.GetCartItemCountAsync();
            }
            <!-- Nav Content -->
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item">
                        <a class="nav-link @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">الرئيسية</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCtrl == "Product" ? "active" : "")" asp-controller="Product" asp-action="Index">منتجاتنا</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="about">من نحن</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentCtrl == "Home" && currentAct == "ContactUs" ? "active" : "")" asp-controller="Home" asp-action="ContactUs">تواصل معنا</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentCtrl == "Account" && currentAct == "Orders" ? "active" : "")" asp-controller="Account" asp-action="Orders">
                                <i class="fas fa-box-archive me-1"></i> طلباتي
                            </a>
                        </li>
                    }
                </ul>

                <!-- Actions -->
                <div class="navbar-actions">
                    <a asp-controller="Product" asp-action="Index" class="action-icon" title="بحث">
                        <i class="fas fa-search"></i>
                    </a>
                    <a asp-controller="Wishlist" asp-action="Index" class="action-icon" title="المفضلة">
                        <i class="far fa-heart"></i>
                    </a>
                    <a asp-controller="Cart" asp-action="Index" class="action-icon navbar-cart-btn" id="navbarCartBtn" title="سلة التسوق">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="cart-badge">@initialCartCount</span>
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown d-inline-block">
                            <button class="btn btn-login dropdown-toggle" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle me-1"></i>
                                @(User.Identity.Name?.Split(' ')[0] ?? "حسابي")
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuBtn">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Orders"><i class="fas fa-box-archive me-2 text-muted"></i> طلباتي</a></li>
                                <li><a class="dropdown-item" asp-controller="Wishlist" asp-action="Index"><i class="fas fa-heart me-2 text-muted"></i> المفضلة</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i> تسجيل الخروج</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-login">
                            <i class="fas fa-user me-1"></i>
                            تسجيل الدخول
                        </a>
                    }
                </div>
            </div>
            </div>
        </nav>

        <!-- ========== MAIN CONTENT ========== -->
        <main>
            @RenderBody()
        </main>

        <!-- ========== FOOTER ========== -->
        <footer class="footer-section">
            <div class="container">
                <div class="row">
                    <!-- Brand Column -->
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="footer-brand">
                            <div class="footer-logo">
                                <span class="footer-logo-icon">
                                    <i class="fas fa-leaf"></i>
                                </span>
                                الشايب
                            </div>
                            <p>
                                مزارع الشايب تقدم لكم أجود المنتجات الطازجة يومياً من المزرعة إلى باب بيتك.
                                نحرص على تقديم منتجات طبيعية ١٠٠٪ بأعلى جودة وأفضل الأسعار.
                            </p>
                            <div class="footer-social">
                                <a href="#" title="فيسبوك"><i class="fab fa-facebook-f"></i></a>
                                <a href="#" title="تويتر"><i class="fab fa-twitter"></i></a>
                                <a href="#" title="انستغرام"><i class="fab fa-instagram"></i></a>
                                <a href="#" title="واتساب"><i class="fab fa-whatsapp"></i></a>
                                <a href="#" title="سناب شات"><i class="fab fa-snapchat-ghost"></i></a>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Links -->
                    <div class="col-lg-2 col-md-6 col-6 mb-4">
                        <div class="footer-col">
                            <h5>روابط سريعة</h5>
                            <ul>
                                <li><a href="#">الرئيسية</a></li>
                                <li><a href="#">من نحن</a></li>
                                <li><a href="#">منتجاتنا</a></li>
                                <li><a href="#">مناطق التوصيل</a></li>
                                <li><a href="#">الأسئلة الشائعة</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Products -->
                    <div class="col-lg-2 col-md-6 col-6 mb-4">
                        <div class="footer-col">
                            <h5>المنتجات</h5>
                            <ul>
                                <li><a href="#">بيض بلدي</a></li>
                                <li><a href="#">بيض مزارع</a></li>
                                <li><a href="#">خضروات طازجة</a></li>
                                <li><a href="#">فواكه موسمية</a></li>
                                <li><a href="#">عروض خاصة</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="footer-col">
                            <h5>تواصل معنا</h5>
                            <div class="footer-contact-item">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>منطقة القصيم، المملكة العربية السعودية</span>
                            </div>
                            <div class="footer-contact-item">
                                <i class="fas fa-phone-alt"></i>
                                <span dir="ltr">+966 50 000 0000</span>
                            </div>
                            <div class="footer-contact-item">
                                <i class="fab fa-whatsapp"></i>
                                <span dir="ltr">+966 50 000 0000</span>
                            </div>
                            <div class="footer-contact-item">
                                <i class="fas fa-envelope"></i>
                                <span>info&#64;elshaib.com</span>
                            </div>
                            <div class="footer-contact-item">
                                <i class="fas fa-clock"></i>
                                <span>يومياً من ٥:٠٠ صباحاً حتى ١١:٠٠ مساءً</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer Bottom -->
            <div class="footer-bottom">
                <div class="container">
                    <p>
                        &copy; @DateTime.Now.Year جميع الحقوق محفوظة لـ <strong>مزارع الشايب</strong> |
                        <a href="#" style="color: rgba(255,255,255,0.65);">سياسة الخصوصية</a> |
                        <a href="#" style="color: rgba(255,255,255,0.65);">الشروط والأحكام</a>
                    </p>
                </div>
            </div>
        </footer>

        <!-- Global Toast Container -->
        <div class="toast-container position-fixed bottom-0 start-0 p-3" style="z-index: 9999;">
            <div id="globalToast" class="toast align-items-center text-white bg-success border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center gap-2">
                        <i class="fas fa-check-circle fs-5" id="toastIcon"></i>
                        <span id="toastMessage"></span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script>
            window.showToast = function(message, type = 'success') {
                const toastEl = document.getElementById('globalToast');
                const toastMsg = document.getElementById('toastMessage');
                const toastIcon = document.getElementById('toastIcon');
                if (!toastEl) return;
                toastEl.className = 'toast align-items-center text-white border-0 shadow-lg ' + (type === 'success' ? 'bg-success' : 'bg-danger');
                if (toastIcon) toastIcon.className = 'fas fs-5 ' + (type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle');
                if (toastMsg) toastMsg.textContent = message;
                const toast = new bootstrap.Toast(toastEl, { delay: 3500 });
                toast.show();
            };


            // Global Wishlist click listener
            document.addEventListener('click', async function(e) {
                const btn = e.target.closest('.btn-wishlist-toggle, .pcard-wishlist, .product-wishlist, .pd-wishlist-btn');
                if (!btn) return;
                e.preventDefault();
                const productId = btn.dataset.productId || btn.closest('[data-product-id]')?.dataset.productId;
                if (!productId) return;

                const icon = btn.querySelector('i');
                try {
                    const formData = new FormData();
                    formData.append('productId', productId);
                    const res = await fetch('/Wishlist/Toggle', { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.success) {
                        if (icon) {
                            if (data.inWishlist) {
                                icon.classList.remove('far');
                                icon.classList.add('fas', 'text-danger');
                            } else {
                                icon.classList.remove('fas', 'text-danger');
                                icon.classList.add('far');
                            }
                        }
                        if (window.showToast) window.showToast(data.message, 'success');
                    }
                } catch(err) {
                    console.error('Wishlist toggle error:', err);
                }
            });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    </body>

</html>
