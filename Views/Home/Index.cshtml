@model List<Product>
@{
    ViewData["Title"] = "الرئيسية";
}

<!-- ========== HERO SECTION ========== -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <!-- Hero Text Content -->
            <div class="col-lg-6 order-lg-1 order-1">
                <div class="hero-content">
                    <div class="hero-badge">
                        مزارع الأقصر الطازجة 🌿
                    </div>

                    <h1 class="hero-brand-name">الشايب</h1>
                    <h2 class="hero-title">طازج يومياً من مزرعتنا إلى بيتك</h2>

                    <p class="hero-description">
                        نقدم لكم أجود المنتجات الطازجة من مزارعنا مباشرة إلى باب بيتك.
                        بيض بلدي، خضروات طازجة، وفواكه موسمية بأعلى جودة وأفضل الأسعار.
                        اطلب الآن واستمتع بطعم الطبيعة الحقيقي.
                    </p>

                    <div class="hero-buttons">
                        <a href="#products" class="btn btn-primary-custom">
                            <i class="fas fa-shopping-basket me-2"></i>
                            تسوق المنتجات
                        </a>
                        <a href="#" class="btn btn-outline-custom">
                            <i class="fas fa-phone-alt me-2"></i>
                            اطلب الآن
                        </a>
                    </div>

                    <div class="hero-search">
                        <input type="text" placeholder="ابحث عن منتجات طازجة..." />
                        <span class="search-icon">
                            <i class="fas fa-search"></i>
                        </span>
                    </div>
                    @* 
                    <p class="hero-promo-text">
                        <i class="fas fa-truck me-1" style="color: #40916C;"></i>
                        ادفع عند الاستلام! <span>أوفر ١٠٠٪ عند الطلب أونلاين</span>
                    </p> *@
                    <!-- Stats Bar -->
                    <div class="stats-bar">
                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div>
                                <div class="stat-value">١٠٠٪</div>
                                <div class="stat-label">طبيعي</div>
                            </div>
                        </div>

                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <div class="stat-value">٠٥:٠٠</div>
                                <div class="stat-label">صباحاً</div>
                            </div>
                        </div>

                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-headset"></i>
                            </div>
                            <div>
                                <div class="stat-value">٢٤/٧</div>
                                <div class="stat-label">دعم متواصل</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero Image -->
            <div class="col-lg-6 order-lg-2 order-2">
                <div class="hero-image-wrapper">
                    <img src="/images/HeroImage.jpg" alt="منتجات مزارع الشايب الطازجة" class="img-fluid" />
                    <div class="hero-image-badge hero-image-badge--top">
                        <i class="fas fa-sun"></i>
                        <span>جمع اليوم 06:00 صباحاً</span>
                    </div>
                    <div class="hero-image-badge hero-image-badge--bottom">
                        <i class="fas fa-leaf"></i>
                        <span>طبيعي 100% بدون هرمونات</span>
                    </div>
                    <div class="hero-image-caption">
                        <small>مزارع الشايب تفخر بكم</small>
                        <strong>إنتاج الصباح الباكر - طازج أولاً</strong>
                    </div>
                </div>
            </div>
        </div>

       
    </div>
</section>

<!-- ========== FEATURES SECTION ========== -->
<section class="features-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--fresh">
                        <i class="fas fa-sun"></i>
                    </div>
                    <h5>طازج يومياً من المزرعة</h5>
                    <p>منتجات طازجة يتم جمعها يومياً من مزارعنا وتوصيلها مباشرة إليك</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--quality">
                        <i class="fas fa-award"></i>
                    </div>
                    <h5>جودة عالية ومضمونة</h5>
                    <p>نضمن لك أعلى معايير الجودة في جميع منتجاتنا مع ضمان الاسترجاع</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--value">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h5>منتوج محلية وبأسعار معقولة</h5>
                    <p>منتجات محلية سعودية بأسعار تنافسية ومناسبة للجميع</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--delivery">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h5>توصيل سريع داخل القصيم</h5>
                    <p>خدمة توصيل سريعة ومجانية لجميع مناطق القصيم</p>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ========== PRODUCTS SECTION ========== -->
@if (Model != null)
{
    <section class="products-section" id="products">
        <div class="container">
            <div class="products-header">
                <div class="container">
                    <div class="hero-badge">
                        <i class="fas fa-egg"></i>
                        اختيارات الأسرة والصحة
                    </div>
                    <h2 class="section-title">منتجاتنا
                    </h2>
                </div>
                <p class="section-subtitle">
                    اختر من منتجات البيض الطازج المتوفرة اليوم من إنتاج مزارعنا </p>
                    <div class="products-tabs">
                        <a href="#" class="tab-link active">الأكثر مبيعاً</a>
                        <a href="#" class="tab-link">عرض الكل</a>
                    </div>
                </div>

                <div class="row g-4">
                    @if (Model.Count == 0)
                    {
                        <div class="col-12">
                            <p class="section-subtitle">لا توجد منتجات متاحة حالياً.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var product in Model)
                        {
                            var primaryImage = product.Images.FirstOrDefault(image => image.IsPrimary)
                                ?? product.Images.FirstOrDefault();

                            <div class="col-lg-3 col-md-6">
                                <div class="product-card">
                                    <div class="product-image-wrapper">
                                        <img src="@(primaryImage?.ImageUrl ?? "/images/HeroImage.jpg")"
                                             alt="@(primaryImage?.AltText ?? product.Name)" />
                                        <button class="product-wishlist" type="button" aria-label="إضافة إلى المفضلة">
                                            <i class="far fa-heart"></i>
                                        </button>
                                    </div>
                                    <div class="product-info">
                                        <span class="product-category">
                                            @(product.PackageType ?? product.UnitSize ?? "منتج")
                                        </span>
                                        <h5 class="product-name">@product.Name</h5>
                                        <p class="product-description">@product.Description</p>
                                        <div class="product-price-row">
                                            <span class="product-price">@product.Price.ToString("0.00")</span>
                                            <span class="product-price-currency">ج.م</span>
                                            @if (product.OldPrice.HasValue)
                                            {
                                                <span class="product-old-price">@product.OldPrice.Value.ToString("0.00") ج.م</span>
                                            }
                                        </div>
                                        <div class="product-actions">
                                            <button class="btn-add-cart" type="button">
                                                <i class="fas fa-cart-plus me-1"></i>
                                                أضف للسلة
                                            </button>
                                            <button asp-action="Details" asp-controller="Product" class="btn-details"
                                                    type="button">تفاصيل أكثر</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <!-- View All Link -->
                    <div class="products-view-all">
                        <a href="#">
                            عرض جميع المنتجات والأحجام المتوفرة
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </section>
        }



        <!-- ========== WHY CHOOSE US SECTION ========== -->
        <section class="why-section" id="about">
            <div class="container text-center">
                <p class="section-subtitle mb-1">تعرف علينا</p>
                <h2 class="section-title">لماذا تختار الشايب؟</h2>
                <p class="section-subtitle">
                    لأننا نقدم لكم منتجات طازجة ومحلية بأعلى معايير الجودة والنظافة مباشرة من مزارعنا إلى بيتكم
                </p>

                <div class="row g-4 mt-2">
                    <div class="col-lg-3 col-md-6">
                        <div class="why-card">
                            <div class="why-icon why-icon--heart">
                                <i class="fas fa-heart"></i>
                            </div>
                            <h5>رضا العملاء هدفنا الأولي</h5>
                            <p>نسعى دائماً لتحقيق أعلى مستويات الرضا من خلال جودة المنتجات وسرعة التوصيل</p>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="why-card">
                            <div class="why-icon why-icon--package">
                                <i class="fas fa-box-open"></i>
                            </div>
                            <h5>حفظ ونقل آمن</h5>
                            <p>نستخدم أحدث طرق التعبئة والتغليف لضمان وصول المنتجات بحالة ممتازة</p>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="why-card">
                            <div class="why-icon why-icon--award">
                                <i class="fas fa-award"></i>
                            </div>
                            <h5>التزام بالجودة والنظافة</h5>
                            <p>نلتزم بأعلى معايير الجودة والنظافة في جميع مراحل الإنتاج والتوصيل</p>
                        </div>
                    </div>

                    <div class="col-lg-3 col-md-6">
                        <div class="why-card">
                            <div class="why-icon why-icon--gift">
                                <i class="fas fa-gift"></i>
                            </div>
                            <h5>عروض لربيع الجوالات</h5>
                            <p>عروض حصرية ومستمرة عبر تطبيقنا على الجوال مع خصومات وهدايا مميزة</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ========== HOW TO ORDER SECTION ========== -->
        <section class="steps-section">
            <div class="container text-center">
                <h2 class="section-title">كيف تطلب من مزارع الشايب؟</h2>
                <p class="section-subtitle">
                    خطوات بسيطة ومريحة للحصول على منتجات طازجة من مزارعنا مباشرة إلى بيتك بكل سهولة
                </p>

                <div class="row g-4 steps-row">
                    <!-- Step 1 -->
                    <div class="col-lg-3 col-md-6">
                        <div class="step-card">
                            <div class="step-number">١</div>
                            <div class="step-icon">
                                <i class="fas fa-search"></i>
                            </div>
                            <h5>التصفح والبحث عن المنتجين</h5>
                            <p>تصفح منتجاتنا المتنوعة واختر من بين مجموعة واسعة من المنتجات الطازجة</p>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="col-lg-3 col-md-6">
                        <div class="step-card">
                            <div class="step-number">٢</div>
                            <div class="step-icon">
                                <i class="fas fa-hand-pointer"></i>
                            </div>
                            <h5>اختيار ما تريد أن تطلبه</h5>
                            <p>أضف المنتجات التي ترغب بها إلى سلة التسوق واختر الكميات المناسبة</p>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="col-lg-3 col-md-6">
                        <div class="step-card">
                            <div class="step-number">٣</div>
                            <div class="step-icon">
                                <i class="fas fa-credit-card"></i>
                            </div>
                            <h5>الدفع وتأكيد الطلب</h5>
                            <p>أكد طلبك واختر طريقة الدفع المناسبة - نقداً عند الاستلام أو إلكترونياً</p>
                        </div>
                    </div>

                    <!-- Step 4 -->
                    <div class="col-lg-3 col-md-6">
                        <div class="step-card">
                            <div class="step-number">٤</div>
                            <div class="step-icon">
                                <i class="fas fa-truck"></i>
                            </div>
                            <h5>الموعد والتوصيل المستمر</h5>
                            <p>نوصل طلبك في الموعد المحدد مع إمكانية الاشتراك بالتوصيل المنتظم</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

