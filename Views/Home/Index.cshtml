@model List<Product>
@{
    ViewData["Title"] = "الرئيسية";
}

<!-- ========== HERO SECTION ========== -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <!-- Hero Text Content -->
            <div class="col-lg-6 order-lg-1 order-1">
                <div class="hero-content">
                    <div class="hero-badge">
                        مزارع الأقصر الطازجة 🌿
                    </div>

                    <h1 class="hero-brand-name">الشايب</h1>
                    <h2 class="hero-title">طازج يومياً من مزرعتنا إلى بيتك</h2>

                    <p class="hero-description">
                        نقدم لكم أجود المنتجات الطازجة من مزارعنا مباشرة إلى باب بيتك.
                        بيض بلدي، خضروات طازجة، وفواكه موسمية بأعلى جودة وأفضل الأسعار.
                        اطلب الآن واستمتع بطعم الطبيعة الحقيقي.
                    </p>

                    <div class="hero-buttons">
                        <a href="#products" class="btn btn-primary-custom">
                            <i class="fas fa-shopping-basket me-2"></i>
                            تسوق المنتجات
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-custom">
                            <i class="fas fa-store me-2"></i>
                            جميع الأصناف
                        </a>
                    </div>

                    <form method="get" asp-controller="Product" asp-action="Index" class="hero-search">
                        <input type="text" name="Query" placeholder="ابحث عن منتجات طازجة..." />
                        <button type="submit" class="search-icon" aria-label="بحث">
                            <i class="fas fa-search"></i>
                        </button>
                    </form>
                    @* 
                    <p class="hero-promo-text">
                        <i class="fas fa-truck me-1" style="color: #40916C;"></i>
                        ادفع عند الاستلام! <span>أوفر ١٠٠٪ عند الطلب أونلاين</span>
                    </p> *@
                    <!-- Stats Bar -->
                    <div class="stats-bar">
                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div>
                                <div class="stat-value">١٠٠٪</div>
                                <div class="stat-label">طبيعي</div>
                            </div>
                        </div>

                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <div class="stat-value">٠٥:٠٠</div>
                                <div class="stat-label">صباحاً</div>
                            </div>
                        </div>

                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-headset"></i>
                            </div>
                            <div>
                                <div class="stat-value">٢٤/٧</div>
                                <div class="stat-label">دعم متواصل</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero Image -->
            <div class="col-lg-6 order-lg-2 order-2">
                <div class="hero-image-wrapper">
                    <picture>
                        <source srcset="/images/HeroImage.webp" type="image/webp" />
                        <img src="/images/HeroImage.jpg" alt="منتجات مزارع الشايب الطازجة" class="img-fluid" width="588" height="441" fetchpriority="high" decoding="async" />
                    </picture>
                    <div class="hero-image-badge hero-image-badge--top">
                        <i class="fas fa-sun"></i>
                        <span>جمع اليوم 06:00 صباحاً</span>
                    </div>
                    <div class="hero-image-badge hero-image-badge--bottom">
                        <i class="fas fa-leaf"></i>
                        <span>طبيعي 100% بدون هرمونات</span>
                    </div>
                    <div class="hero-image-caption">
                        <small>مزارع الشايب تفخر بكم</small>
                        <strong>إنتاج الصباح الباكر - طازج أولاً</strong>
                    </div>
                </div>
            </div>
        </div>

       
    </div>
</section>

<!-- ========== FEATURES SECTION ========== -->
<section class="features-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--fresh">
                        <i class="fas fa-sun"></i>
                    </div>
                    <h5>طازج يومياً من المزرعة</h5>
                    <p>منتجات طازجة يتم جمعها يومياً من مزارعنا وتوصيلها مباشرة إليك</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--quality">
                        <i class="fas fa-award"></i>
                    </div>
                    <h5>جودة عالية ومضمونة</h5>
                    <p>نضمن لك أعلى معايير الجودة في جميع منتجاتنا مع ضمان الاسترجاع</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--value">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h5>منتجات طازجة بأسعار تنافسية</h5>
                    <p>منتجات طبيعية ومحلية طازجة بأسعار مباشرة ومناسبة للجميع</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--delivery">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h5>توصيل سريع داخل الأقصر</h5>
                    <p>خدمة توصيل سريعة ومجانية للطلبات المؤهلة لجميع مناطق الأقصر</p>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- ========== PRODUCTS SECTION ========== -->
@if (Model != null)
{
    <section class="products-section" id="products">
        <div class="container">
            <div class="products-header">
                <div class="hero-badge">
                    <i class="fas fa-egg"></i>
                    اختيارات الأسرة والصحة
                </div>
                <h2 class="section-title">منتجاتنا الطازجة</h2>
                <p class="section-subtitle">
                    اختر من منتجات البيض الطازج المتوفرة اليوم من إنتاج مزارعنا
                </p>
                <div class="products-tabs">
                    <a href="#products" class="tab-link active">الأكثر مبيعاً</a>
                    <a asp-controller="Product" asp-action="Index" class="tab-link">عرض الكل</a>
                </div>
            </div>

            <div class="row g-4">
                @if (Model.Count == 0)
                {
                    <div class="col-12">
                        <p class="section-subtitle">لا توجد منتجات متاحة حالياً.</p>
                    </div>
                }
                else
                {
                    @foreach (var product in Model)
                    {
                        var primaryImage = product.Images.FirstOrDefault(image => image.IsPrimary)
                            ?? product.Images.FirstOrDefault();
                        var hasDiscount = product.OldPrice.HasValue && product.OldPrice.Value > product.Price;
                        var discountPercent = hasDiscount
                            ? (int)Math.Round((1 - (double)product.Price / (double)product.OldPrice!.Value) * 100)
                            : 0;

                        <div class="col-lg-3 col-md-6">
                            <div class="product-card">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                   class="product-image-link">
                                    <div class="product-image-wrapper">
                                        <img src="@(primaryImage?.ImageUrl ?? "/images/HeroImage.jpg")"
                                             alt="@(primaryImage?.AltText ?? product.Name)"
                                             width="280"
                                             height="200"
                                             fetchpriority="high"
                                             onerror="this.onerror=null;this.src='/images/HeroImage.jpg';"
                                             style="object-fit: cover;" />
                                        @if (hasDiscount)
                                        {
                                            <span class="product-badge-discount">خصم @discountPercent%</span>
                                        }
                                    </div>
                                </a>
                                <button class="product-wishlist" type="button" aria-label="إضافة إلى المفضلة" data-product-id="@product.Id">
                                    <i class="far fa-heart"></i>
                                </button>
                                <div class="product-info">
                                    <span class="product-category">
                                        @(product.PackageType ?? product.UnitSize ?? product.Category?.Name ?? "منتج طازج")
                                    </span>
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                       class="product-name-link">
                                        <h5 class="product-name">@product.Name</h5>
                                    </a>
                                    <p class="product-description">@product.Description</p>
                                    <div class="product-price-row">
                                        <span class="product-price">@product.Price.ToString("0.00")</span>
                                        <span class="product-price-currency">ج.م</span>
                                        @if (hasDiscount)
                                        {
                                            <span class="product-old-price">@product.OldPrice!.Value.ToString("0.00") ج.م</span>
                                        }
                                    </div>
                                    <div class="product-actions">
                                        <button class="btn-add-cart btn-home-add-cart" type="button" data-product-id="@product.Id">
                                            <i class="fas fa-cart-plus me-1"></i>
                                            أضف للسلة
                                        </button>
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id"
                                           class="btn-details">تفاصيل</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }

                    <!-- View All Link -->
                    <div class="products-view-all">
                        <a asp-controller="Product" asp-action="Index">
                            عرض جميع المنتجات والأحجام المتوفرة
                            <i class="fas fa-arrow-left"></i>
                        </a>
                    </div>
                </div>
            </section>
        }



        <!-- ========== WHY CHOOSE US SECTION ========== -->
        <section class="why-section" id="about">
            <div class="container text-center">
                <p class="section-subtitle mb-1">تعرف علينا</p>
                <h2 class="section-title">لماذا تختار الشايب؟</h2>
                <p class="section-subtitle">
                    لأننا نقدم لكم منتجات طازجة ومحلية بأعلى معايير الجودة والنظافة مباشرة من مزارعنا إلى بيتكم
                </p>

                <div class="row g-4 mt-2">
                    <div class="col-lg-3 col-md-6">
