@{
    ViewData["Title"] = "الرئيسية";
}

<!-- ========== HERO SECTION ========== -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <!-- Hero Text Content -->
            <div class="col-lg-6 order-lg-1 order-1">
                <div class="hero-content">
                    <div class="hero-badge">
                        مزارع الأقصر الطازجة 🌿
                    </div>

                    <h1 class="hero-brand-name">الشايب</h1>
                    <h2 class="hero-title">طازج يومياً من مزرعتنا إلى بيتك</h2>

                    <p class="hero-description">
                        نقدم لكم أجود المنتجات الطازجة من مزارعنا مباشرة إلى باب بيتك.
                        بيض بلدي، خضروات طازجة، وفواكه موسمية بأعلى جودة وأفضل الأسعار.
                        اطلب الآن واستمتع بطعم الطبيعة الحقيقي.
                    </p>

                    <div class="hero-buttons">
                        <a href="#products" class="btn btn-primary-custom">
                            <i class="fas fa-shopping-basket me-2"></i>
                            تسوق المنتجات
                        </a>
                        <a href="#" class="btn btn-outline-custom">
                            <i class="fas fa-phone-alt me-2"></i>
                            اطلب الآن
                        </a>
                    </div>

                    <div class="hero-search">
                        <input type="text" placeholder="ابحث عن منتجات طازجة..." />
                        <span class="search-icon">
                            <i class="fas fa-search"></i>
                        </span>
                    </div>
                    @* 
                    <p class="hero-promo-text">
                        <i class="fas fa-truck me-1" style="color: #40916C;"></i>
                        ادفع عند الاستلام! <span>أوفر ١٠٠٪ عند الطلب أونلاين</span>
                    </p> *@
                    <!-- Stats Bar -->
                    <div class="stats-bar">
                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div>
                                <div class="stat-value">١٠٠٪</div>
                                <div class="stat-label">طبيعي</div>
                            </div>
                        </div>

                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <div class="stat-value">٠٥:٠٠</div>
                                <div class="stat-label">صباحاً</div>
                            </div>
                        </div>

                        <div class="stat-badge">
                            <div class="stat-icon">
                                <i class="fas fa-headset"></i>
                            </div>
                            <div>
                                <div class="stat-value">٢٤/٧</div>
                                <div class="stat-label">دعم متواصل</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hero Image -->
            <div class="col-lg-6 order-lg-2 order-2">
                <div class="hero-image-wrapper">
                    <img src="/images/HeroImage.jpg" alt="منتجات مزارع الشايب الطازجة" class="img-fluid" />
                    <div class="hero-image-badge hero-image-badge--top">
                        <i class="fas fa-sun"></i>
                        <span>جمع اليوم 06:00 صباحاً</span>
                    </div>
                    <div class="hero-image-badge hero-image-badge--bottom">
                        <i class="fas fa-leaf"></i>
                        <span>طبيعي 100% بدون هرمونات</span>
                    </div>
                    <div class="hero-image-caption">
                        <small>مزارع الشايب تفخر بكم</small>
                        <strong>إنتاج الصباح الباكر - طازج أولاً</strong>
                    </div>
                </div>
            </div>
        </div>

       
    </div>
</section>

<!-- ========== FEATURES SECTION ========== -->
<section class="features-section">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--fresh">
                        <i class="fas fa-sun"></i>
                    </div>
                    <h5>طازج يومياً من المزرعة</h5>
                    <p>منتجات طازجة يتم جمعها يومياً من مزارعنا وتوصيلها مباشرة إليك</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--quality">
                        <i class="fas fa-award"></i>
                    </div>
                    <h5>جودة عالية ومضمونة</h5>
                    <p>نضمن لك أعلى معايير الجودة في جميع منتجاتنا مع ضمان الاسترجاع</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--value">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h5>منتوج محلية وبأسعار معقولة</h5>
                    <p>منتجات محلية سعودية بأسعار تنافسية ومناسبة للجميع</p>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="feature-card">
                    <div class="feature-icon feature-icon--delivery">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h5>توصيل سريع داخل القصيم</h5>
                    <p>خدمة توصيل سريعة ومجانية لجميع مناطق القصيم</p>
                </div>
            </div>
        </div>
    </div>
</section>


